{
  "name": "fieldline",
  "version": "1.0.0",
  "description": "Fieldline hunting map",
  "author": "Fieldline contributors",
  "main": "desktop/main.mjs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "node scripts/browser-smoke.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:test": "node --test desktop/*.test.mjs scripts/desktop-bundle.test.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --dir --publish never",
    "desktop:dist": "node scripts/desktop-dist.mjs",
    "desktop:win": "node scripts/desktop-dist.mjs win",
    "desktop:mac": "node scripts/desktop-dist.mjs mac",
    "desktop:linux": "node scripts/desktop-dist.mjs linux",
    "desktop:bundle": "node scripts/desktop-bundle.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "lucide-react": "^0.510.0",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "^6.13.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "org.fieldline.desktop",
    "productName": "Fieldline",
    "directories": {
      "output": "release",
      "app": "desktop"
    },
    "files": [
      "*.mjs",
      "!*.test.mjs",
      "!**/node_modules{,/**/*}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".desktop-output",
        "to": "fieldline",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/icons/fieldline-512.png",
        "to": "fieldline-icon.png"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "artifactName": "Fieldline-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/fieldline-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icons/fieldline-512.png",
      "category": "public.app-category.travel",
      "extendInfo": {
        "NSLocationUsageDescription": "Fieldline uses your location only when you request GPS tracking or positioning."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icons/fieldline-512.png",
      "category": "Maps"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "yazl": "3.3.1"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
